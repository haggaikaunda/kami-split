{
  "name": "kami-split",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @kami-split/web dev",
    "build": "pnpm --filter @kami-split/web build",
    "start": "pnpm --filter @kami-split/web start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --filter @kami-split/web typecheck && tsc --project tsconfig.docs.json --noEmit",
    "test": "pnpm --filter @kami-split/web test",
    "test:watch": "pnpm --filter @kami-split/web test:watch",
    "relay:generate": "node scripts/relay/generate.mjs",
    "relay:check": "node scripts/relay/generate.mjs --validate"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "graphql": "17.0.2",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
